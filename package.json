{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --test 'scripts/**/*.test.ts' 'src/**/*.test.ts'",
    "check:html": "html-validate 'dist/**/*.html'",
    "check:no-js": "node scripts/check-no-js.ts dist",
    "check:contrast": "node scripts/check-contrast.ts dist",
    "check:slugs": "node scripts/check-slugs.ts dist",
    "check:seo": "node scripts/check-seo.ts dist",
    "check": "npm run typecheck && npm test && npm run build && npm run check:html && npm run check:no-js && npm run check:contrast && npm run check:slugs && npm run check:seo"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.3.5",
    "beautiful-mermaid": "1.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.1",
    "html-validate": "11.16.2",
    "typescript": "6.0.3"
  }
}
