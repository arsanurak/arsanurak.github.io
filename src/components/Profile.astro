---
import { profile } from "../data/profile";
import SkillsCredentials from "./SkillsCredentials.astro";
---

<header class="profile">
  <div class="intro">
    <h1>{profile.name}</h1>
    <p class="headline">{profile.headline}</p>
    <p class="tagline">{profile.tagline}</p>
  </div>

  <section>
    <h2 class="label">Where</h2>
    <p>{profile.location}</p>
  </section>

  <section>
    <h2 class="label">Contact</h2>
    <ul class="contact">
      <li><a href={profile.linkedin.href}>{profile.linkedin.label}</a></li>
    </ul>
  </section>

  <!-- Phones: folded into a native disclosure. Desktop: always shown. -->
  <details class="fold">
    <summary>Skills &amp; credentials</summary>
    <SkillsCredentials />
  </details>
  <div class="full">
    <SkillsCredentials />
  </div>
</header>

<style>
  .profile {
    background: var(--panel);
    color: var(--on-panel);
    padding: 32px 16px;
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .profile :global(.label) {
    color: var(--panel-muted);
    margin-bottom: 6px;
  }

  p {
    margin: 0;
    color: var(--panel-muted);
    font-size: 15px;
  }

  h1 {
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--on-panel);
    margin: 0 0 8px;
  }

  .headline {
    color: var(--on-panel);
    font-size: 17px;
    font-weight: 500;
    margin-bottom: 6px;
  }

  .tagline {
    font: 400 15px/1.4 var(--font-mono);
    color: var(--panel-accent);
  }

  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
    overflow-wrap: anywhere;
  }

  .contact a {
    color: var(--on-panel);
    text-decoration-color: var(--panel-accent);
    text-underline-offset: 3px;
  }

  summary {
    cursor: pointer;
    color: var(--panel-muted);
    font: 500 12px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 0;
  }

  .fold[open] summary {
    margin-bottom: 14px;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--panel-accent);
    outline-offset: 2px;
  }

  .full {
    display: none;
  }

  @media (min-width: 820px) {
    .profile {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      padding: 40px 28px;
      gap: 24px;
    }

    .fold {
      display: none;
    }

    .full {
      display: block;
    }
  }
</style>
