---
import { demoRepo, profile } from "../data/profile";
---

<footer>
  <div class="wrap inner">
    <p>{profile.name}</p>
    <ul>
      <li><a href={profile.linkedin.href}>LinkedIn</a></li>
      <li><a href={demoRepo.href}>platform-demo</a></li>
      <li><a href="/how-this-site-is-built/">How this site is built</a></li>
    </ul>
  </div>
</footer>

<style>
  footer {
    background: var(--footer);
    border-top: 1px solid var(--line);
    color: var(--body);
    font-size: 14px;
  }

  .inner {
    padding-top: 20px;
    padding-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 0 32px;
    align-items: center;
    justify-content: space-between;
  }

  p {
    margin: 12px 0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  a {
    display: inline-block;
    padding: 12px 0;
    line-height: 20px;
  }
</style>
