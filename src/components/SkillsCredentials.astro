---
import { profile } from "../data/profile";
---

<div class="skills-credentials">
  <section>
    <h2 class="label">Works with</h2>
    <ul class="skills">
      {profile.skills.map((skill) => <li>{skill}</li>)}
    </ul>
  </section>
  <section>
    <h2 class="label">Credentials</h2>
    <ul class="credentials">
      {profile.credentials.map((credential) => <li>{credential}</li>)}
    </ul>
  </section>
</div>

<style>
  .skills-credentials {
    display: grid;
    gap: 24px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .skills li {
    font: 12px/1.4 var(--font-mono);
    border: 1px solid var(--panel-line);
    border-radius: var(--radius);
    padding: 3px 8px;
  }

  .credentials {
    color: var(--panel-muted);
    font-size: 15px;
  }
</style>
