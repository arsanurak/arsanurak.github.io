---
import { getCollection, render, type CollectionEntry } from "astro:content";
import WithProfile from "../../layouts/WithProfile.astro";
import { profile } from "../../data/profile";

// Every case study follows this shape, in this order. A case study whose
// sections differ fails the build.
const SHAPE = [
  "Context",
  "Problem",
  "Constraints",
  "Options considered",
  "Decision and why",
  "Rollout",
  "Outcome",
  "What I'd do differently",
  "See it in code",
];

export async function getStaticPaths() {
  const entries = await getCollection("caseStudies");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"caseStudies">;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

// Markdown turns ' into ’, so compare with straight apostrophes.
const sections = headings.filter((h) => h.depth === 2).map((h) => h.text.replace(/’/g, "'"));
if (sections.join("|") !== SHAPE.join("|")) {
  throw new Error(
    `${entry.filePath}: sections must be exactly, in order: ${SHAPE.join(" → ")}\nFound: ${sections.join(" → ")}`,
  );
}
---

<WithProfile title={`${data.title} · ${profile.name}`} description={data.summary}>
  <article>
    <a class="back" href="/#work">← Back to timeline</a>

    <header>
      <p class="eyebrow">2018–present · Case study</p>
      <h1>{data.title}</h1>
    </header>

    <div class="status">
      <table>
        <caption class="visually-hidden">Decision record</caption>
        <tbody>
          <tr><th scope="row">Status</th><td>{data.status}</td></tr>
          <tr><th scope="row">Area</th><td>{data.area}</td></tr>
          <tr><th scope="row">Decision</th><td>{data.decision}</td></tr>
          <tr><th scope="row">Code</th><td><a href={data.code}>{data.code.replace(/^https:\/\//, "")}</a></td></tr>
        </tbody>
      </table>
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>
</WithProfile>

<style>
  article {
    display: grid;
    gap: 28px;
  }

  .back {
    font: 400 13px/1.4 var(--font-mono);
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .eyebrow {
    font: 500 13px/1.6 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 8px;
  }

  h1 {
    font-size: clamp(26px, 4.5vw, 38px);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
    text-wrap: balance;
  }

  .status {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font: 13px/1.5 var(--font-mono);
  }

  th,
  td {
    border: 1px solid var(--line);
    padding: 8px 10px;
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--muted);
    font-weight: 400;
    width: 110px;
    white-space: nowrap;
  }

  .prose {
    max-width: 66ch;
  }

  .prose :global(h2) {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    margin: 36px 0 10px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(code) {
    font: 14px var(--font-mono);
    background: var(--accent-soft);
    padding: 1px 5px;
    border-radius: var(--radius);
  }

  .prose :global(.diagram) {
    margin: 24px 0;
    padding: 20px 16px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .prose :global(.diagram svg),
  .prose :global(.diagram img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .prose :global(figcaption) {
    font: 13px/1.5 var(--font-mono);
    color: var(--muted);
    margin-top: 12px;
  }

  .prose :global(blockquote) {
    margin: 0 0 14px;
    padding: 12px 16px;
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
</style>
