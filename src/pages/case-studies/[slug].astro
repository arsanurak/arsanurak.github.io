---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Page from "../../layouts/Page.astro";
import { profile } from "../../data/profile";

// Every case study follows this shape, in this order. A case study whose
// sections differ fails the build.
const SHAPE = [
  "Context",
  "Problem",
  "Constraints",
  "Options considered",
  "Decision and why",
  "Rollout",
  "Outcome",
  "What I'd do differently",
  "See it in code",
];

export async function getStaticPaths() {
  const entries = await getCollection("caseStudies");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"caseStudies">;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

// Markdown turns ' into ’, so compare with straight apostrophes.
const sections = headings.filter((h) => h.depth === 2).map((h) => h.text.replace(/’/g, "'"));
if (sections.join("|") !== SHAPE.join("|")) {
  throw new Error(
    `${entry.filePath}: sections must be exactly, in order: ${SHAPE.join(" → ")}\nFound: ${sections.join(" → ")}`,
  );
}
---

<Page
  title={`${data.title} · ${profile.name}`}
  description={data.summary}
  ogType="article"
  ogImage={data.ogImage && { ...data.ogImage.src, alt: data.ogImage.alt }}
>
  <article class="page">
    <a class="back" href="/#proof">← All case studies</a>

    <header>
      <p class="eyebrow">2018–present · Case study</p>
      <h1 class="page-title">{data.title}</h1>
    </header>

    <div class="status">
      <table>
        <caption class="visually-hidden">Decision record</caption>
        <tbody>
          <tr><th scope="row">Status</th><td>{data.status}</td></tr>
          <tr><th scope="row">Area</th><td>{data.area}</td></tr>
          <tr><th scope="row">Decision</th><td>{data.decision}</td></tr>
          <tr><th scope="row">Code</th><td><a href={data.code}>{data.code.replace(/^https:\/\//, "")}</a></td></tr>
        </tbody>
      </table>
    </div>

    <div class="prose">
      <Content />
      <p class="code-link"><a href={data.code}>Browse the code in {data.code.replace(/^https:\/\/github\.com\//, "")} →</a></p>
    </div>
  </article>
</Page>

<style>
  .status {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font: 13px/1.5 var(--font-mono);
  }

  th,
  td {
    border: 1px solid var(--line);
    padding: 8px 10px;
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--muted);
    font-weight: 400;
    width: 110px;
    white-space: nowrap;
  }

  .prose :global(.diagram) {
    margin: 24px 0;
    padding: 20px 16px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .prose :global(.diagram svg),
  .prose :global(.diagram img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .prose :global(figcaption) {
    font: 13px/1.5 var(--font-mono);
    color: var(--muted);
    margin-top: 12px;
  }

  .code-link a {
    display: inline-block;
    font: 14px/1.4 var(--font-mono);
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .code-link a:hover {
    border-color: var(--accent);
  }
</style>
