---
import { getCollection } from "astro:content";
import WithProfile from "../layouts/WithProfile.astro";
import { otherWork, profile, roles } from "../data/profile";
import { caseStudyPath } from "../lib/case-study-slugs";

const caseStudies = (await getCollection("caseStudies"))
  .map(({ data }) => data)
  .sort((a, b) => a.order - b.order);
---

<WithProfile title={`${profile.name} · ${profile.headline}`} description={profile.tagline}>
  <p class="summary">{profile.summary}</p>

  <section aria-labelledby="work">
    <h2 id="work">Work, newest first</h2>
    <ol class="timeline">
      {
        roles.map((role) => (
          <li class:list={["stop", { current: role.current }]}>
            <p class="years">{role.years}</p>
            <h3>{role.title}</h3>
            {role.organisation && <p class="organisation">{role.organisation}</p>}
            {role.summary && <p class="role-summary">{role.summary}</p>}
            {role.current && (
              <>
                <ul class="case-studies">
                  {caseStudies.map((study) => (
                    <li>
                      <p class="label kicker">Case study</p>
                      <p class="title"><a href={caseStudyPath(study.slug)}>{study.title}</a></p>
                      <p class="summary">{study.summary}</p>
                    </li>
                  ))}
                </ul>
                <h4 class="label">Other work</h4>
                <ul class="other-work">
                  {otherWork.map((item) => (
                    <li>
                      <strong>{item.title}.</strong> {item.description}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))
      }
    </ol>
  </section>
</WithProfile>

<style>
  .summary {
    margin: 0;
    font-size: 18px;
    max-width: 62ch;
  }

  h2 {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 20px;
  }

  .timeline {
    list-style: none;
    margin: 0 0 0 6px;
    padding: 0;
    border-left: 2px solid var(--line);
  }

  .stop {
    position: relative;
    padding: 0 0 36px 28px;
    display: grid;
    gap: 4px;
  }

  .stop:last-child {
    padding-bottom: 0;
  }

  .stop::before {
    content: "";
    position: absolute;
    left: -8px;
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--ground);
    border: 2px solid var(--line);
  }

  .stop.current::before {
    border-color: var(--accent);
  }

  .stop p {
    margin: 0;
  }

  .years {
    font: 500 13px/1.6 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  .organisation,
  .role-summary {
    color: var(--muted);
    font-size: 15px;
  }

  .case-studies {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .case-studies li {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .kicker {
    color: var(--accent);
  }

  .title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  .title a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .title a:hover {
    color: var(--accent);
  }

  /* The whole card is the link's hit area. */
  .case-studies li {
    position: relative;
  }

  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .case-studies li:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .case-studies .summary {
    color: var(--muted);
    font-size: 14px;
  }

  h4 {
    color: var(--muted);
    margin: 20px 0 4px;
  }

  .other-work {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 10px;
    color: var(--muted);
    font-size: 15px;
  }

  .other-work strong {
    color: var(--ink);
    font-weight: 600;
  }

</style>
