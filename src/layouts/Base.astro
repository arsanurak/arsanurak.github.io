---
import "../styles/global.css";
import sans400 from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-400-normal.woff2?url";
import sans500 from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-500-normal.woff2?url";
import sans700 from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-700-normal.woff2?url";
import sans800 from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-800-normal.woff2?url";
import mono400 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import mono500 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url";

// Self-hosted fonts, preloaded and declared with font-display: optional so
// the page never re-lays out when a web font arrives late (a swap here
// caused a layout shift of about 0.3 on CI runners).
const fonts = [
  { family: "Schibsted Grotesk", weight: 400, url: sans400, preload: true },
  { family: "Schibsted Grotesk", weight: 500, url: sans500, preload: false },
  { family: "Schibsted Grotesk", weight: 700, url: sans700, preload: true },
  { family: "Schibsted Grotesk", weight: 800, url: sans800, preload: true },
  { family: "JetBrains Mono", weight: 400, url: mono400, preload: true },
  { family: "JetBrains Mono", weight: 500, url: mono500, preload: false },
];
const fontFaces = fonts
  .map(
    (f) =>
      `@font-face{font-family:"${f.family}";font-style:normal;font-weight:${f.weight};font-display:optional;src:url(${f.url}) format("woff2")}`,
  )
  .join("");

// The link-preview image. Pages without their own use the site default
// (public/og-default.png, rendered from scripts/og-image/og-default.html).
export interface OgImage {
  src: string;
  width: number;
  height: number;
  alt: string;
}

// What a page tells search engines and link previews. Layouts that wrap Base
// take the same props and pass them straight through.
export interface SeoProps {
  title: string;
  description: string;
  ogType?: "website" | "article";
  ogImage?: OgImage;
}

type Props = SeoProps;

const DEFAULT_OG_IMAGE: OgImage = {
  src: "/og-default.png",
  width: 1200,
  height: 630,
  alt: "Anurak Chatree (Ars), Senior Platform & DevOps Engineer: Kubernetes, GitOps and AWS, debugged from the network layer up.",
};

const { title, description, ogType = "website", ogImage = DEFAULT_OG_IMAGE } = Astro.props;
// Absolute https URLs, built from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(ogImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fonts.filter((f) => f.preload).map((f) => <link rel="preload" href={f.url} as="font" type="font/woff2" crossorigin />)}
    <style set:html={fontFaces} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Anurak Chatree (Ars)" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
